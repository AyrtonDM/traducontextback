APP_NAME=TraduContext
ENVIRONMENT=development
API_V1_PREFIX=/api/v1

DB_HOST=
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_PORT=
DB_ECHO=true

GMAIL_HOST=smtp.gmail.com
GMAIL_PORT=587
GMAIL_USUARIO=
GMAIL_PASSWORD=
GMAIL_REMITENTE=

# Traduccion con LLM, asistencia (HU-30) y transcripcion de reuniones con Whisper (HU-37)
OPENAI_API_KEY=

# Integraciones Meet y Zoom (HU-35 a HU-41), opcionales
# Clave Fernet: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CLAVE_CIFRADO_TOKENS=
# Google Cloud Console > APIs y servicios > Credenciales > ID de cliente OAuth (aplicacion web)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/integraciones/google_meet/callback
# Zoom App Marketplace > Develop > Build App > General App (OAuth)
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=
ZOOM_REDIRECT_URI=http://localhost:8000/api/v1/integraciones/zoom/callback
FRONTEND_URL=http://localhost:4200

# Notificaciones push por Firebase Cloud Messaging (M1), opcional.
# Ruta al JSON de la cuenta de servicio (Firebase > Configuracion > Cuentas de servicio) o el JSON en una linea.
# Vacia: las notificaciones solo se guardan en la base de datos. Nunca subir ese JSON al repositorio.
FIREBASE_CREDENCIALES=
